[flake8]
max-line-length = 88
exclude = 
    .git,
    __pycache__,
    migrations,
    venv,
    env,
    .venv,
    .env,
    node_modules,
    .pytest_cache,
    htmlcov,
    build,
    dist,
    *.egg-info
ignore = 
    E203,
    E501,
    W503,
    F401
per-file-ignores =
    __init__.py:F401
    settings.py:E501
    */migrations/*:E501,F401
max-complexity = 10
count = True
statistics = True
show-source = True
